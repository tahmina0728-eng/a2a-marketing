.gcloudignore
.git
.gitignore

# Python virtual environment — huge, not needed
.venv/

# ADK cache
.adk/
app/.adk/

# Local brand assets — loaded from GCS at runtime
bucket/brands/*/Assets/
bucket/brands/*/Font/
bucket/brands/*/Colours/
bucket/brands/*/Products/
bucket/brands/*/Logos/

# Seed scripts and data files — not needed in container
scripts/
*.csv

# Dev files
*.pyc
__pycache__/
.env
*.env
.DS_Store
