# ─────────────────────────────────────────────────────────────────────────────
# CampaignOS ADK — environment configuration example
# Copy to .env and fill in your values before running.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── GCP project ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# ── Cloud Storage ─────────────────────────────────────────────────────────────
# Bucket that holds brand assets and pipeline outputs.
# Structure: gs://{GCS_BUCKET}/brands/{brand}/Guidelines/brand_guidelines.md
#            gs://{GCS_BUCKET}/brands/{brand}/Products/
#            gs://{GCS_BUCKET}/brands/{brand}/Font/
GCS_BUCKET=your-assets-bucket-name
OUTPUTS_PATH=outputs

# ── BigQuery ──────────────────────────────────────────────────────────────────
# Source data read via Vertex AI Search (not queried directly by agents)
BQ_DATASET=briefing_agent
BQ_CAMPAIGNS_TABLE=historical_campaigns
BQ_FAN_TRUTHS_TABLE=fan_truth_library
BQ_CHANNELS_TABLE=channel_benchmarks

# Output audit log written by save_brief_output tool
BQ_OUTPUT_DATASET=campaign_outputs
BQ_OUTPUT_TABLE=machine_briefs

# Set to false to skip BigQuery writes (useful before tables exist or in dev)
BQ_LOGGING_ENABLED=false

# ── Vertex AI Search ──────────────────────────────────────────────────────────
# One Search App with two datastores (GCS guidelines + BigQuery benchmarks).
SEARCH_ENGINE_ID=your-search-engine-id
SEARCH_LOCATION=global
SEARCH_MAX_RESULTS=10
SEARCH_SUMMARY_RESULT_COUNT=5

# search_mode controls where benchmark data comes from:
#   live      → Vertex AI Search (requires datastore setup)
#   gcs_files → read guidelines from GCS bucket; use stub benchmark data
SEARCH_MODE=gcs_files

# ── Gemini models ─────────────────────────────────────────────────────────────
# Reasoning / text agents (briefing, strategy, KV generators, ranker, etc.)
GEMINI_MODEL_REASONING=gemini-2.5-flash

# Image generation (KV background generation + image-to-image swap/bake)
GEMINI_MODEL_IMAGE=gemini-3.1-flash-image-preview

# ── Brand assets ──────────────────────────────────────────────────────────────
# mode: local → reads from brand_assets_local_path/brands/{brand}/
#        gcs  → reads from gs://{GCS_BUCKET}/brands/{brand}/
BRAND_ASSETS_MODE=gcs

# Path relative to the project root for local brand bucket files.
# Default "bucket" resolves to rebuild/bucket/ when running from rebuild/.
# BRAND_ASSETS_LOCAL_PATH=bucket

# ── Service ───────────────────────────────────────────────────────────────────
SERVICE_NAME=campaignos-adk
LOG_LEVEL=INFO

# environment controls startup logging and behaviour flags.
# Use "development" locally; "production" on Cloud Run / Agent Engine.
ENVIRONMENT=development
