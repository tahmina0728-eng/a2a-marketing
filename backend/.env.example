# CampaignOS Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to git

# ── GCP ────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./campaignos-sa-key.json
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# ── Storage ────────────────────────────────────────────────
GCS_BUCKET=your-gcp-project-id-campaignos
BIGQUERY_DATASET=campaignos
BIGQUERY_PROJECT=your-gcp-project-id

# ── Firestore ──────────────────────────────────────────────
FIRESTORE_DATABASE=(default)

# ── GA4 ────────────────────────────────────────────────────
# Find at: analytics.google.com → Admin → Property Settings
GA4_PROPERTY_ID=properties/123456789

# ── Google Ads ─────────────────────────────────────────────
# Apply at: ads.google.com/nav/selectaccount → API Centre
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CLIENT_ID=your-oauth-client-id
GOOGLE_ADS_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADS_CUSTOMER_ID=your-customer-id-no-dashes

# ── Meta (Instagram/Facebook) ──────────────────────────────
# Get at: developers.facebook.com → My Apps → your app
META_ACCESS_TOKEN=your-meta-access-token
META_AD_ACCOUNT_ID=act_your-ad-account-id
META_PAGE_ID=your-page-id

# ── Frontend ───────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── App ────────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=INFO
